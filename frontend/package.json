{
  "name": "vungu-master-alpha-frontend",
  "version": "1.0.1",
  "description": "Vue 3 frontend for Vungu Spatial Data Portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "build:strict": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node node_modules/@tauri-apps/cli/tauri.js build",
    "desktop:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-desktop.ps1",
    "desktop:build": "npm run tauri:build -- --config src-tauri/tauri.windows.conf.json",
    "desktop:publish-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-installer-local.ps1",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:responsive": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --root . --no-file-parallelism",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "type-check": "vue-tsc --noEmit",
    "gis:symbology:report": "node scripts/seed-gis-style-registry.mjs --report",
    "gis:symbology:seed": "node scripts/seed-gis-style-registry.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.16",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.3.5",
    "@turf/boolean-contains": "^7.3.5",
    "@turf/boolean-overlap": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.3.5",
    "@turf/turf": "^6.5.0",
    "@types/ol": "^6.5.3",
    "axios": "^1.6.2",
    "canvg": "^4.0.3",
    "clsx": "^2.0.0",
    "dxf-parser": "^1.1.2",
    "flatgeobuf": "^4.5.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.8",
    "jsts": "^2.12.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^4.7.1",
    "ol": "^10.11.0",
    "ol-mapbox-style": "^13.5.1",
    "pdf-lib": "^1.17.1",
    "pinia": "^2.3.1",
    "pmtiles": "^4.5.0",
    "proj4": "^2.20.2",
    "proj4leaflet": "^1.0.2",
    "shpjs": "^6.2.0",
    "svg2pdf": "^1.1.1",
    "tailwindcss": "^3.3.6",
    "topojson-client": "^3.1.0",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^20.9.0",
    "@types/proj4": "^2.5.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.2",
    "@vue/tsconfig": "^0.4.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.18.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.32",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  },
  "keywords": [
    "vue",
    "typescript",
    "vite",
    "maplibre",
    "spatial"
  ],
  "author": "Vungu RDC",
  "license": "MIT"
}
