      </tasks>
    </section>
  </chapter>

  <appendix>
    <section title="System Commands">
      <commands>
        <command name="System Status">
          <syntax>systemctl status vungu-phase2</syntax>
          <description>Check overall system status</description>
        </command>
        <command name="Service Restart">
          <syntax>systemctl restart vungu-api</syntax>
          <description>Restart API service</description>
        </command>
        <command name="Database Backup">
          <syntax>pg_dump vungu_phase2 > backup.sql</syntax>
          <description>Create manual database backup</description>
        </command>
        <command name="Log Review">
          <syntax>tail -f /var/log/vungu/api.log</syntax>
          <description>Monitor API logs in real-time</description>
        </command>
      </commands>
    </section>
    
