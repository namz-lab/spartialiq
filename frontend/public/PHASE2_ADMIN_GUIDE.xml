  <chapter id="system-administration" num="1" title="System Administration">
    <section title="Administrator Responsibilities">
      <responsibilities>
        <responsibility>User account management</responsibility>
        <responsibility>System configuration</responsibility>
        <responsibility>Service monitoring</responsibility>
        <responsibility>Security oversight</responsibility>
        <responsibility>Performance optimization</responsibility>
        <responsibility>Backup and recovery</responsibility>
      </responsibilities>
    </section>
    
    <section title="Access Control">
      <access-levels>
        <level name="Super Admin">
          <permissions>Full system access, user management, system configuration</permissions>
        </level>
        <level name="System Admin">
          <permissions>Service management, monitoring, limited user management</permissions>
        </level>
        <level name="Service Admin">
          <permissions>Specific service administration, data management</permissions>
        </level>
        <level name="Read-only Admin">
          <permissions>View-only access to system status and reports</permissions>
        </level>
      </access-levels>
    </section>
    
    <section title="System Configuration">
      <config-sections>
        <section name="Database Settings">
          <parameters>
            <param name="Connection Pool Size">Recommended: 20-50 connections</param>
            <param name="Query Timeout">Recommended: 30 seconds</param>
            <param name="Backup Schedule">Recommended: Daily at 2:00 AM</param>
          </parameters>
        </section>
        
        <section name="API Settings">
          <parameters>
            <param name="Rate Limiting">Auth: 15/min, API: 100/min, Upload: 5/min</param>
            <param name="Request Timeout">Recommended: 60 seconds</param>
            <param name="CORS Origins">Configure allowed domains</param>
          </parameters>
        </section>
        
        <section name="Security Settings">
          <parameters>
            <param name="Session Timeout">Recommended: 4 hours</param>
            <param name="Password Policy">Min 8 chars, uppercase, lowercase, numbers, symbols</param>
            <param name="2FA Requirement">Recommended for all admin accounts</param>
          </parameters>
        </section>
      </config-sections>
    </section>
  </chapter>

  <chapter id="service-management" num="2" title="Service Management">
    <section title="Data Cleaning Service">
      <service-config>
        <setting name="Max File Size">100MB per upload</setting>
        <setting name="Supported Formats">SHP, GeoJSON, KML, CSV, GPKG</setting>
        <setting name="Validation Rules">Geometry, attributes, topology, CRS</setting>
        <setting name="Processing Timeout">30 minutes per job</setting>
      </service-config>
      
      <maintenance-tasks>
        <task frequency="Daily">Clean up temporary files</task>
        <task frequency="Weekly">Review job performance metrics</task>
        <task frequency="Monthly">Update validation rule sets</task>
      </maintenance-tasks>
    </section>
    
    <section title="QML Parser Service">
      <service-config>
        <setting name="Template Library Size">Maximum 1000 templates</setting>
        <setting name="Template Size Limit">1MB per template</setting>
        <setting name="Validation Strictness">Standard QML compliance</setting>
        <setting name="Cache Duration">24 hours for parsed templates</setting>
      </service-config>
      
      <maintenance-tasks>
        <task frequency="Weekly">Validate template library integrity</task>
        <task frequency="Monthly">Update QML schema definitions</task>
        <task frequency="Quarterly">Archive unused templates</task>
      </maintenance-tasks>
    </section>
    
    <section title="Approval Workflow Service">
      <service-config>
        <setting name="Max Workflow Steps">10 steps per workflow</setting>
        <setting name="Timeout Period">7 days per step</setting>
        <setting name="Notification Settings">Email, in-app, SMS options</setting>
        <setting name="Escalation Rules">Auto-escalate after timeout</setting>
      </service-config>
      
      <maintenance-tasks>
        <task frequency="Daily">Review pending approvals</task>
        <task frequency="Weekly">Check workflow performance</task>
        <task frequency="Monthly">Update workflow templates</task>
      </maintenance-tasks>
    </section>
    
    <section title="Batch Processing Service">
      <service-config>
        <setting name="Concurrent Jobs">Maximum 5 concurrent jobs</setting>
        <setting name="Job Queue Size">Maximum 100 queued jobs</setting>
        <setting name="Memory Limit">2GB per job</setting>
        <setting name="Timeout Period">2 hours per job</setting>
      </service-config>
      
      <maintenance-tasks>
        <task frequency="Hourly">Monitor job queue status</task>
        <task frequency="Daily">Review failed jobs</task>
        <task frequency="Weekly">Optimize job scheduling</task>
      </maintenance-tasks>
    </section>
  </chapter>

  <chapter id="monitoring" num="3" title="Monitoring & Analytics">
    <section title="System Metrics">
      <metrics>
        <metric name="CPU Usage">
          <threshold warning="70%" critical="90%"</threshold>
          <monitoring-frequency>Real-time</monitoring-frequency>
        </metric>
        <metric name="Memory Usage">
          <threshold warning="80%" critical="95%"</threshold>
          <monitoring-frequency>Real-time</monitoring-frequency>
        </metric>
        <metric name="Disk Usage">
          <threshold warning="85%" critical="95%"</threshold>
          <monitoring-frequency>Every 5 minutes</monitoring-frequency>
        </metric>
        <metric name="Database Connections">
          <threshold warning="80" critical="95"</threshold>
          <monitoring-frequency>Real-time</monitoring-frequency>
        </metric>
      </metrics>
    </section>
    
    <section title="Service Performance">
      <performance-indicators>
        <indicator name="API Response Time">
          <target>&lt;500ms for 95% of requests</target>
          <measurement>Average over 1-hour windows</measurement>
        </indicator>
        <indicator name="Job Processing Time">
          <target>Within configured timeouts</target>
          <measurement>Per job type tracking</measurement>
        </indicator>
        <indicator name="Error Rate">
          <target>&lt;1% of total requests</target>
          <measurement>Rolling 24-hour average</measurement>
        </indicator>
      </performance-indicators>
    </section>
    
    <section title="User Analytics">
      <analytics>
        <metric name="Active Users">
          <description>Users logged in within last 24 hours</description>
        </metric>
        <metric name="Feature Usage">
          <description>Most used system features</description>
        </metric>
        <metric name="Job Statistics">
          <description>Jobs created, completed, failed per day</description>
        </metric>
      </analytics>
    </section>
  </chapter>

  <chapter id="security-administration" num="4" title="Security Administration">
    <section title="User Management">
      <user-policies>
        <policy name="Account Creation">
          <rule>Require admin approval for new accounts</rule>
          <rule>Default role: Read-only</rule>
        </policy>
        <policy name="Password Policy">
          <rule>Minimum 8 characters</rule>
          <rule>Require uppercase, lowercase, numbers, symbols</rule>
          <rule>Expiration every 90 days</rule>
        </policy>
        <policy name="Account Lockout">
          <rule>Lock after 5 failed attempts</rule>
          <rule>Auto-unlock after 30 minutes</rule>
        </policy>
      </user-policies>
    </section>
    
    <section title="Security Monitoring">
      <monitoring-areas>
        <area name="Authentication Events">
          <events>Login attempts, password changes, 2FA usage</events>
          <alerting>Failed login attempts, suspicious locations</alerting>
        </area>
        <area name="Authorization Events">
          <events>Permission changes, role modifications</events>
          <alerting>Unauthorized access attempts</alerting>
        </area>
        <area name="Data Access">
          <events>File downloads, data exports</events>
          <alerting>Mass data access, unusual patterns</alerting>
        </area>
      </monitoring-areas>
    </section>
    
    <section title="Incident Response">
      <incident-types>
        <type name="Security Breach">
          <response>Immediate system lockdown, investigation, notification</response>
        </type>
        <type name="Data Loss">
          <response>Assess impact, restore from backup, review procedures</response>
        </type>
        <type name="Service Outage">
          <response>Identify cause, restore service, communicate with users</response>
        </type>
      </incident-types>
    </section>
  </chapter>

  <chapter id="performance-optimization" num="5" title="Performance Optimization">
    <section title="Database Optimization">
      <optimization-techniques>
        <technique name="Index Management">
          <description>Regular index analysis and rebuilding</description>
          <frequency>Monthly</frequency>
        </technique>
        <technique name="Query Optimization">
          <description>Review slow queries and optimize execution plans</description>
          <frequency>Weekly</frequency>
        </technique>
        <technique name="Connection Pooling">
          <description>Optimize connection pool settings</description>
          <frequency>As needed based on load</frequency>
        </technique>
      </optimization-techniques>
    </section>
    
    <section title="Application Performance">
      <optimization-areas>
        <area name="Caching">
          <strategies>Redis for session cache, application cache for frequent data</strategies>
        </area>
        <area name="Load Balancing">
          <strategies>Distribute API requests across multiple instances</strategies>
        </area>
        <area name="Resource Management">
          <strategies>Monitor memory usage, optimize garbage collection</strategies>
        </area>
      </optimization-areas>
    </section>
    
    <section title="Network Optimization">
      <optimization-techniques>
        <technique name="CDN Usage">
          <description>Use CDN for static assets and documentation</description>
        </technique>
        <technique name="Compression">
          <description>Enable gzip compression for API responses</description>
        </technique>
        <technique name="HTTP/2">
          <description>Enable HTTP/2 for improved performance</description>
        </technique>
      </optimization-techniques>
    </section>
  </chapter>

  <chapter id="backup-recovery" num="6" title="Backup & Recovery">
    <section title="Backup Strategy">
      <backup-types>
        <type name="Full Database Backup">
          <frequency>Daily at 2:00 AM</frequency>
          <retention>30 days</retention>
        </type>
        <type name="Incremental Backup">
          <frequency>Every 4 hours</frequency>
          <retention>7 days</retention>
        </type>
        <type name="Configuration Backup">
          <frequency>Weekly</frequency>
          <retention>90 days</retention>
        </type>
        <type name="Log Backup">
          <frequency>Daily</frequency>
          <retention>30 days</retention>
        </type>
      </backup-types>
    </section>
    
    <section title="Recovery Procedures">
      <recovery-scenarios>
        <scenario name="Data Corruption">
          <steps>
            <step>Identify corruption scope</step>
            <step>Stop affected services</step>
            <step>Restore from last known good backup</step>
            <step>Verify data integrity</step>
            <step>Restart services</step>
          </steps>
        </scenario>
        <scenario name="System Failure">
          <steps>
            <step>Assess failure impact</step>
            <step>Initiate disaster recovery plan</step>
            <step>Restore system from backups</step>
            <step>Test all services</step>
            <step>Notify users of recovery</step>
          </steps>
        </scenario>
      </recovery-scenarios>
    </section>
    
    <section title="Testing Backup Integrity">
      <testing-procedures>
        <procedure name="Backup Verification">
          <frequency>Monthly</frequency>
          <steps>Random backup selection, restore test, data verification</steps>
        </procedure>
        <procedure name="Recovery Drill">
          <frequency>Quarterly</frequency>
          <steps>Simulated failure scenario, full recovery test</steps>
        </procedure>
      </testing-procedures>
    </section>
  </chapter>

  <chapter id="troubleshooting" num="7" title="Troubleshooting">
    <section title="Common System Issues">
      <issue id="high-cpu">
        <title>High CPU Usage</title>
        <symptoms>System response slow, CPU usage > 80%</symptoms>
        <causes>
          <cause>Inefficient database queries</cause>
          <cause>Memory leaks</cause>
          <cause>Excessive concurrent jobs</cause>
        </causes>
        <solutions>
          <solution>Review and optimize slow queries</solution>
          <solution>Restart affected services</solution>
          <solution>Implement job queuing limits</solution>
        </solutions>
      </issue>
      
      <issue id="memory-issues">
        <title>Memory Issues</title>
        <symptoms>Out of memory errors, system crashes</symptoms>
        <causes>
          <cause>Memory leaks in applications</cause>
          <cause>Insufficient allocated memory</cause>
          <cause>Large data processing jobs</cause>
        </causes>
        <solutions>
          <solution>Monitor memory usage patterns</solution>
          <solution>Increase memory allocation</solution>
          <solution>Implement memory limits for jobs</solution>
        </solutions>
      </issue>
    </section>
    
    <section title="Service-Specific Issues">
      <service-issues>
        <service name="Data Cleaning">
          <issue>Job failures during processing</issue>
          <troubleshooting>Check file format, validate data structure, review logs</troubleshooting>
        </service>
        <service name="QML Parser">
          <issue>Template validation failures</issue>
          <troubleshooting>Verify QML syntax, check schema compliance, test with sample data</troubleshooting>
        </service>
        <service name="Approval Workflow">
          <issue>Workflow stuck in pending state</issue>
          <troubleshooting>Check user permissions, review workflow configuration, verify notifications</troubleshooting>
        </service>
        <service name="Batch Processing">
          <issue>Jobs not starting</issue>
          <troubleshooting>Check queue status, verify resource availability, review job configuration</troubleshooting>
        </service>
      </service-issues>
    </section>
  </chapter>

