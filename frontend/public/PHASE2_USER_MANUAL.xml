  <chapter id="troubleshooting" num="8" title="Troubleshooting">
    <section title="Common Issues">
      <issue id="import-failure">
        <title>Data Import Fails</title>
        <symptoms>Import process stops or returns errors</symptoms>
        <causes>
          <cause>Invalid file format</cause>
          <cause>Corrupted data file</cause>
          <cause>Insufficient permissions</cause>
        </causes>
        <solutions>
          <solution>Verify file format compatibility</solution>
          <solution>Check file integrity</solution>
          <solution>Ensure proper permissions</solution>
        </solutions>
      </issue>
      
      <issue id="validation-errors">
        <title>Data Validation Errors</title>
        <symptoms>Validation reports multiple errors</symptoms>
        <causes>
          <cause>Invalid geometries</cause>
          <cause>Missing required attributes</cause>
          <cause>Incorrect coordinate system</cause>
        </causes>
        <solutions>
          <solution>Run geometry repair tools</solution>
          <solution>Complete missing attributes</solution>
          <solution>Reproject to correct CRS</solution>
        </solutions>
      </issue>
    </section>
  </chapter>

