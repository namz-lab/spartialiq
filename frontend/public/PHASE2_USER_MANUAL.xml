  <chapter id="data-cleaning" num="3" title="Data Cleaning Service">
    <section title="Overview">
      <para>The Data Cleaning Service provides comprehensive tools for validating, cleaning, and transforming spatial data. This service ensures data quality and consistency across all spatial datasets.</para>
    </section>
    
    <section title="Data Import">
      <import-formats>
        <format>Shapefile (.shp)</format>
        <format>GeoJSON (.json)</format>
        <format>KML/KMZ (.kml, .kmz)</format>
        <format>CSV (.csv)</format>
        <format>GeoPackage (.gpkg)</format>
      </import-formats>
      
      <import-steps>
        <step num="1">Select data source</step>
        <step num="2">Choose file format</step>
        <step num="3">Upload file</step>
        <step num="4">Configure import settings</step>
        <step num="5">Validate data structure</step>
        <step num="6">Process import</step>
      </import-steps>
    </section>
    
    <section title="Data Validation">
      <validation-rules>
        <rule type="geometry">Valid geometry structures</rule>
        <rule type="attributes">Required field completeness</rule>
        <rule type="projections">Coordinate reference system</rule>
        <rule type="topology">Spatial relationship integrity</rule>
        <rule type="attributes">Data type consistency</rule>
      </validation-rules>
    </section>
    
    <section title="Cleaning Operations">
      <operations>
        <operation name="Remove Duplicates">
          <description>Identify and remove duplicate features based on geometry and attributes</description>
        </operation>
        <operation name="Fix Geometries">
          <description>Repair invalid geometries using automated algorithms</description>
        </operation>
        <operation name="Standardize Attributes">
          <description>Normalize attribute values and formats</description>
        </operation>
        <operation name="Projection Transformation">
          <description>Transform data to standard coordinate reference system</description>
        </operation>
      </operations>
    </section>
  </chapter>

