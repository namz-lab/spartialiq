{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SpartialIQ Local",
  "version": "1.0.1",
  "identifier": "zw.gov.vungu.spatialiq.local",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm.cmd run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpartialIQ Local",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://tauri.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000 https://api.maptiler.com https://basemaps.cartocdn.com https://*.arcgisonline.com https://github.com https://*.github.com https://objects.githubusercontent.com; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/local-stack/backend",
      "resources/node/node.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0RkJGQ0M0Q0M4MEU0QzkKUldUSjVJRE14UHo3MUpTRnBUSTNhSkg0aFJCNjlnT28rWFJ5UTc0QVdObXljRjNXSUl5L2FZZkQK",
      "endpoints": [
        "https://github.com/Muna18madzinga/Manicipal-drums-frontend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
