{
  "name": "tillbook-pos",
  "private": true,
  "version": "1.0.0",
  "description": "Tillbook — POS, stock, quotations, receipts and books for independent retailers.",
  "author": "Tillbook",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 4180",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "app.tillbook.desktop",
    "productName": "Tillbook",
    "directories": { "output": "desktop/dist" },
    "files": ["dist/**/*", "desktop/main.cjs", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "Tillbook-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tillbook"
    }
  }
}
